# Django defaults to local development when these are omitted.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,0.0.0.0,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Required in production. Store a Django make_password() hash, never the
# shared plaintext password. Sessions use a one-year rolling expiry by default.
GAMESCAL_ACCESS_PASSWORD_HASH=
GAMESCAL_ACCESS_SESSION_AGE=31536000

# Geoapify project key used for geocoding and driving-time estimates.
GEOAPIFY_API_KEY=
